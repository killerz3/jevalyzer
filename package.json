{
  "name": "jevalyzer",
  "version": "0.1.0",
  "description": "Grade your Claude Code, Codex, opencode, Gemini CLI and Antigravity sessions with Jev",
  "type": "module",
  "bin": {
    "jevalyzer": "./bin/jevalyzer.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "jevalyzer": "bun run src/cli.ts",
    "build": "bun build --compile --minify src/cli.ts --outfile dist/jevalyzer",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.87",
    "@ai-sdk/typesafe-ai": "3.0.4",
    "ai": "7.0.105",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "jev",
    "typesafe",
    "claude-code",
    "codex",
    "opencode",
    "gemini-cli",
    "antigravity",
    "ai-agent",
    "llm-evaluation",
    "cli",
    "transcript-analysis",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/USER/jevalyzer.git"
  },
  "homepage": "https://github.com/USER/jevalyzer#readme",
  "bugs": {
    "url": "https://github.com/USER/jevalyzer/issues"
  }
}
